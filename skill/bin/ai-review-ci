#!/usr/bin/env bash
# ai-review-ci — run /code-reviewer headlessly for CI environments.
#
# Reads PR context from CI env vars and invokes the Claude Code CLI in
# --print mode. Bypasses all interactive prompts (the skill detects
# AI_REVIEW_CI=1 and auto-confirms every [y/n] prompt). Designed to be
# called from a Bitbucket Pipelines step (or any CI provider).
#
# Required env vars:
#   ANTHROPIC_API_KEY        Claude API key for headless invocation (pay-per-token
#     — or —               API billing), OR an OAuth token from `claude
#   CLAUDE_CODE_OAUTH_TOKEN  setup-token` (Pro/Max subscription — usage draws
#                            from that person's subscription quota, so fine for
#                            trials, wrong for a whole team's CI; prefer the API
#                            key for shared pipelines). One of the two must be set.
#   BITBUCKET_EMAIL          For the skill's Bitbucket REST calls.
#   BITBUCKET_API_TOKEN
#
# Optional env vars:
#   JIRA_BASE_URL            For Step 10 — Sync Jira card status.
#   JIRA_EMAIL               (falls back to BITBUCKET_EMAIL)
#   JIRA_API_TOKEN           (falls back to BITBUCKET_API_TOKEN)
#   BITBUCKET_PR_ID          Auto-set by Bitbucket Pipelines on PR steps.
#   BITBUCKET_BRANCH         Auto-set by Bitbucket Pipelines.
#   AI_REVIEW_MAX_USD        Caps spend per run. A runaway killswitch, not a budget.
#                            Default tracks the model: 15.00 on opus (the default
#                            model), 5.00 on sonnet. Set explicitly to override.
#                            Do not tune it down without measuring first:
#                            a run killed mid-review bills every token it spent and
#                            posts nothing, so a cap set too tight converts working
#                            reviews into pure waste.
#                            On OAuth the figure bills nobody — there is no dollar
#                            invoice — but --max-budget-usd still terminates the run
#                            at that estimated spend, which makes it the only
#                            available killswitch. Without it a single pathological
#                            run can eat a large share of one person's daily
#                            subscription quota, and every pipeline review in the
#                            team draws from that same quota.
#                            Why these numbers. The sonnet figure is measured, not
#                            guessed. A real review on a
#                            substantial diff (30 turns, 2.06M cache-read + 178k
#                            cache-write input, 21k output) came to $2.05. Two things
#                            about that number are easy to get wrong:
#                              * It is computed at STANDARD Sonnet rates ($3/$15),
#                                not the introductory $2/$10 — and the cap gates on
#                                this figure, so introductory pricing is irrelevant
#                                to whether a run survives.
#                              * Cache WRITES were 52% of it. The CLI uses a 1-hour
#                                cache TTL, billed at 2x input, while a CI container
#                                lives ~5 minutes and never reuses the entry. There
#                                is no flag to shorten it (checked on 2.1.224).
#                            A 2.00 default killed exactly that review. 5.00 is ~2.4x
#                            a known-real run: loose enough to let a large diff
#                            finish, tight enough that a true runaway (10x+) still
#                            trips. The opus figure (15.00) holds that same ~2.4x
#                            ratio against opus's ~5x per-token cost — it is DERIVED,
#                            not measured. Re-derive BOTH from the per-run "Usage"
#                            block below rather than from this comment, as diffs,
#                            the lens, and model pricing all change.
#   AI_REVIEW_MODEL          Model for the run: "opus" (default) or "sonnet" — the
#                            skill refuses to review on anything else, so an
#                            unsupported value fails pre-flight (exit 1).
#                            opus is the default because the lens is judgement work,
#                            not pattern matching: the mechanical style rules moved
#                            out to Rector/PHPStan, and what is left (§1g structure,
#                            §2p name-matches-behaviour, §4a logic-vs-presentation,
#                            §7 correctness, §13a untested logic, §16 scale, §17
#                            contract breaks) is exactly where model quality shows.
#                            sonnet remains the big cost lever if spend matters more
#                            than depth — set it explicitly and the cap follows.
#   AI_REVIEW_OUTPUT         Path for the JSON output. Default: ./ai-review-output.json
#   AI_REVIEW_BASE_BRANCH    Base branch the diff is scoped against. Default: develop.
#                            Set to "master" (etc.) for a repo with a different
#                            integration branch. Inherited by the skill via env.
#
# Exit codes:
#   0  Run completed (review posted; findings may or may not exist).
#   1  Infrastructure failure (missing env, claude CLI not installed, etc.).
#   2  Claude returned a non-zero exit (run errored mid-flight).

set -uo pipefail

# ── Pre-flight env checks ─────────────────────────────────────────────────────
if [[ -z "${ANTHROPIC_API_KEY:-}" && -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
    echo "ERROR: set ANTHROPIC_API_KEY (API billing) or CLAUDE_CODE_OAUTH_TOKEN" >&2
    echo "       (from \`claude setup-token\`, Pro/Max subscription) for headless CI mode." >&2
    exit 1
fi
if [[ -z "${BITBUCKET_EMAIL:-}" || -z "${BITBUCKET_API_TOKEN:-}" ]]; then
    echo "ERROR: BITBUCKET_EMAIL and BITBUCKET_API_TOKEN are required (the skill posts comments via Bitbucket REST)." >&2
    exit 1
fi
if ! command -v claude >/dev/null 2>&1; then
    echo "ERROR: 'claude' CLI not on PATH. Install Claude Code in the CI image." >&2
    exit 1
fi

# ── Build the prompt ──────────────────────────────────────────────────────────
PR_ARG=""
if [[ -n "${BITBUCKET_PR_ID:-}" ]]; then
    PR_ARG="--pr=$BITBUCKET_PR_ID"
elif [[ -n "${BITBUCKET_BRANCH:-}" ]]; then
    PR_ARG="--branch=$BITBUCKET_BRANCH"
fi

PROMPT="/code-reviewer $PR_ARG"
# The skill runs on sonnet or opus only (see SKILL.md "Model guard") — it refuses to
# review on anything else. Resolve and validate the model FIRST: the budget default
# below is derived from it, and an unsupported override must die here (exit 1) rather
# than at the in-skill guard after the container has already spun up.
MODEL="${AI_REVIEW_MODEL:-opus}"
case "$MODEL" in
    sonnet|opus) ;;
    *)
        echo "ERROR: AI_REVIEW_MODEL='$MODEL' — code-reviewer only runs on sonnet or opus." >&2
        echo "       Unset AI_REVIEW_MODEL (defaults to opus) or set it to 'sonnet' or 'opus'." >&2
        exit 1
        ;;
esac
MODEL_ARGS=(--model "$MODEL")

# Budget: explicit var wins; otherwise the default tracks the model. On OAuth the
# figure bills nobody, but --max-budget-usd still terminates a runaway run — and a
# runaway there spends one person's subscription quota, which the whole team's CI
# shares. Uncapped is not "free", it's just unmetered.
#
# The sonnet figure (5.00) is ~2.4x a measured real review ($2.05, at STANDARD sonnet
# rates — introductory pricing does not apply, the cap gates on the standard figure).
# The opus figure (15.00) holds the same ~2.4x ratio against opus's ~5x per-token
# cost. It is DERIVED, not measured: re-derive both from the "─── Usage ───" block
# this script prints once you have real opus runs, and correct them here.
#
# The cap MUST track the model, and is derived from the validated $MODEL above so the
# two can never drift. Opus costs roughly 5x sonnet per token, so the measured $2.05
# sonnet review lands near $10 on opus — straight through a 5.00 cap, mid-review,
# which bills every token spent and posts nothing. That is the exact failure the 2.00
# default caused before; repeating it via a model change instead of a cap change would
# be the same bug wearing a hat. An explicit AI_REVIEW_MAX_USD still wins.
if [[ "$MODEL" == "sonnet" ]]; then
    DEFAULT_MAX_USD=5.00
else
    DEFAULT_MAX_USD=15.00
fi
MAX_USD="${AI_REVIEW_MAX_USD:-$DEFAULT_MAX_USD}"
BUDGET_ARGS=(--max-budget-usd "$MAX_USD")
OUTPUT_FILE="${AI_REVIEW_OUTPUT:-./ai-review-output.json}"

# Tells the skill (via SKILL.md "CI / headless mode" section) to skip prompts.
export AI_REVIEW_CI=1

# ── Tool allowlist ────────────────────────────────────────────────────────────
# Mode: --permission-mode dontAsk + UNQUALIFIED tool names below. dontAsk
# auto-denies anything not allow-listed, so the list must actually match every
# call the skill makes. Pattern-scoped entries like "Bash(git *)" DO NOT work
# here: in target mode (--pr/--branch — exactly what CI uses) the skill runs
# compound commands (`cd "$WORKTREE" && "$SKILLS_ROOT/scripts/foo.sh"`), which
# never match a single command pattern and were silently denied — the run
# analysed the diff but couldn't post. Unqualified "Bash" allows all Bash calls.
#
# Why not bypassPermissions? CI containers run as root, and the CLI hard-blocks
# bypass mode under root/sudo (exit 1, "cannot be used with root/sudo
# privileges"). There is no sanctioned override; dontAsk + a full allowlist is
# the root-compatible equivalent for this ephemeral, single-purpose container.
# Anthropic auth uses ANTHROPIC_API_KEY (a CI container has no keychain / OAuth).
# "Task" is deliberately ABSENT: the skill is single-agent by policy (subagent
# fan-out multiplies token cost), and dontAsk auto-denies any stray Task call.
ALLOWED_TOOLS=(
    "Read"
    "Write"
    "Edit"
    "Glob"
    "Grep"
    "Bash"
    "TodoWrite"
)

# ── Banner ────────────────────────────────────────────────────────────────────
echo "🚀 ai-review-ci — running /code-reviewer headlessly"
echo "  Prompt        : $PROMPT"
echo "  Max budget    : \$$MAX_USD$([[ -n "${ANTHROPIC_API_KEY:-}" ]] || echo " (runaway guard — OAuth spends subscription quota, not dollars)")"
echo "  Base branch   : ${AI_REVIEW_BASE_BRANCH:-develop}"
echo "  Auth          : $([[ -n "${ANTHROPIC_API_KEY:-}" ]] && echo "API key" || echo "OAuth token (subscription)")"
echo "  Model         : ${MODEL}$([[ -n "${AI_REVIEW_MODEL:-}" ]] || echo " (default)")"
echo "  Output JSON   : $OUTPUT_FILE"
echo

# ── Pre-flight: is there anything to review? ──────────────────────────────────
# Built for the every-push model: the pipeline fires on PR creation and on each
# push, so a share of builds have nothing new. The skill already detects that —
# but only at the scoping step, *inside* the Claude run, after the skill, the
# worktree, card context and three comment fetches have all loaded. That is a
# double-digit number of turns to conclude "nothing to do".
#
# This gate reaches the same conclusion with three Bitbucket API calls and zero
# tokens. It skips only when BOTH hold:
#   1. the checkpoint SHA equals HEAD  → no new commits to analyse, and
#   2. no developer reply is awaiting an answer.
# Condition 2 matters: a64e0f3 exists because a 0-commit rerun must still handle
# replies (a concession changes the card's correct status). Skipping a run with
# a pending reply would leave a developer talking to nobody.
#
# Fails OPEN everywhere — any missing script, bad exit, or unparseable output
# runs the review. A gate that wrongly skips is far worse than one that wrongly
# runs. Set AI_REVIEW_NO_PREFLIGHT=1 to bypass it entirely.
SKILL_SCRIPTS=".claude/skills/code-reviewer/scripts"

nothing_to_review() {
    [[ -z "${AI_REVIEW_NO_PREFLIGHT:-}" ]]                      || return 1
    command -v git >/dev/null 2>&1                              || return 1
    [[ -x "$SKILL_SCRIPTS/get_checkpoint.sh" ]]                 || return 1
    [[ -x "$SKILL_SCRIPTS/check_replies.py" ]]                  || return 1

    local checkpoint head replies n
    checkpoint=$("$SKILL_SCRIPTS/get_checkpoint.sh" 2>/dev/null) || return 1
    [[ -n "$checkpoint" ]]                                       || return 1  # first review
    head=$(git rev-parse HEAD 2>/dev/null)                       || return 1
    [[ "$checkpoint" == "$head" ]]                               || return 1  # new commits

    replies=$("$SKILL_SCRIPTS/check_replies.py" 2>/dev/null)     || return 1
    n=$(printf '%s' "$replies" | python3 -c "
import json, sys
try:    print(len(json.load(sys.stdin)))
except Exception: print(-1)          # unparseable → -1 → fail open
" 2>/dev/null) || return 1
    [[ "$n" == "0" ]]                                            || return 1  # replies pending
    return 0
}

if nothing_to_review; then
    echo "✓ Nothing to review — checkpoint matches HEAD and no replies are awaiting a"
    echo "  response. Skipping the Claude run entirely (0 tokens)."
    # The card can still be stale if a finding was dismissed out-of-band since the
    # last run, so sync it. Pure Python, no tokens, idempotent, soft-fails.
    if [[ -x "$SKILL_SCRIPTS/check_resolved.py" && -x "$SKILL_SCRIPTS/update_card_status.py" ]]; then
        OPEN_N=$("$SKILL_SCRIPTS/check_resolved.py" 2>/dev/null | python3 -c "
import json, sys
try:    print(len(json.load(sys.stdin)))
except Exception: print(0)
" 2>/dev/null) || OPEN_N=0
        [[ "$OPEN_N" -gt 0 ]] && HAS_OPEN=true || HAS_OPEN=false
        "$SKILL_SCRIPTS/update_card_status.py" --has-open-findings="$HAS_OPEN" || true
    fi
    echo
    echo "✓ ai-review-ci completed (no-op). Pass AI_REVIEW_NO_PREFLIGHT=1 to force a run."
    exit 0
fi

# ── Trust the workspace so the project skill loads ────────────────────────────
# `claude --print` skips the trust *dialog* but does not *grant* trust. An
# untrusted workspace silently refuses to load the project's /code-reviewer
# skill — the prompt resolves to "Unknown command: /code-reviewer" and nothing
# runs — and ignores settings permissions. Pre-accept trust for this checkout.
CLAUDE_CONFIG="${HOME:-/root}/.claude.json"
python3 - "$PWD" "$CLAUDE_CONFIG" <<'PYTRUST' || echo "  ↷ couldn't pre-trust workspace (continuing)" >&2
import json, os, sys
workspace, cfg = sys.argv[1], sys.argv[2]
data = {}
if os.path.exists(cfg):
    try:
        data = json.load(open(cfg))
    except Exception:
        data = {}
proj = data.setdefault("projects", {}).setdefault(workspace, {})
proj["hasTrustDialogAccepted"] = True
proj["hasCompletedProjectOnboarding"] = True
with open(cfg, "w") as f:
    json.dump(data, f)
PYTRUST

# ── Invoke Claude headlessly ──────────────────────────────────────────────────
# NOTE: no --bare. --bare does NOT load project skills, so /code-reviewer would
# resolve to "Unknown command" and the review would never run. Verified against
# CLI v2.1.220. Auth still uses ANTHROPIC_API_KEY.
claude --print "$PROMPT" \
    --no-session-persistence \
    --output-format json \
    --permission-mode dontAsk \
    "${BUDGET_ARGS[@]}" \
    "${MODEL_ARGS[@]}" \
    --allowedTools "${ALLOWED_TOOLS[@]}" \
    --disallowedTools "Task" \
    > "$OUTPUT_FILE"
RC=$?

echo
echo "─── Claude run finished (exit code $RC) ───"
if command -v jq >/dev/null 2>&1; then
    jq -r '.result // .' "$OUTPUT_FILE" 2>/dev/null || cat "$OUTPUT_FILE"
else
    cat "$OUTPUT_FILE"
fi

# ── Spend report ──────────────────────────────────────────────────────────────
# --output-format json carries the CLI's own usage block. Echo it so a cost spike
# shows up in the pipeline log of the run that caused it, instead of being
# reconstructed from git history weeks later. Printed before the exit-code check:
# a run that died mid-review still spent the tokens, and those are the ones worth
# seeing. Soft-fails — a missing field never fails the step.
if command -v python3 >/dev/null 2>&1; then
    python3 - "$OUTPUT_FILE" <<'PYUSAGE' || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
u = d.get("usage") or {}
inp   = u.get("input_tokens", 0)
out   = u.get("output_tokens", 0)
cread = u.get("cache_read_input_tokens", 0)
cwrit = u.get("cache_creation_input_tokens", 0)
cost  = d.get("total_cost_usd")
turns = d.get("num_turns")
secs  = (d.get("duration_ms") or 0) / 1000 or None
if not any([inp, out, cread, cwrit, cost, turns]):
    sys.exit(0)
print()
print("─── Usage ───")
print(f"  Input tokens  : {inp:,} (+{cwrit:,} cache write, {cread:,} cache read)")
print(f"  Output tokens : {out:,}")
if turns is not None:
    print(f"  Turns         : {turns}")
if secs:
    print(f"  Duration      : {secs:.0f}s")
if cost is not None:
    # On subscription auth this is an equivalent-spend estimate, not an invoice.
    print(f"  Est. spend    : ${cost:.4f}")
PYUSAGE
fi

if [[ $RC -ne 0 ]]; then
    echo "❌ Headless run failed (exit $RC). See $OUTPUT_FILE for details." >&2
    exit 2
fi

echo
echo "✓ ai-review-ci completed. Findings posted to PR (if any). Output: $OUTPUT_FILE"
exit 0
