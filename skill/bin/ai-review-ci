#!/usr/bin/env bash
# ai-review-ci — run /code-reviewer headlessly for CI environments.
#
# Reads PR context from CI env vars and invokes the Claude Code CLI in
# --print mode. Bypasses all interactive prompts (the skill detects
# AI_REVIEW_CI=1 and auto-confirms every [y/n] prompt). Designed to be
# called from a Bitbucket Pipelines step (or any CI provider).
#
# Required env vars:
#   ANTHROPIC_API_KEY        Claude API key for headless invocation (pay-per-token
#     — or —               API billing), OR an OAuth token from `claude
#   CLAUDE_CODE_OAUTH_TOKEN  setup-token` (Pro/Max subscription — usage draws
#                            from that person's subscription quota, so fine for
#                            trials, wrong for a whole team's CI; prefer the API
#                            key for shared pipelines). One of the two must be set.
#   BITBUCKET_EMAIL          For the skill's Bitbucket REST calls.
#   BITBUCKET_API_TOKEN
#
# Optional env vars:
#   JIRA_BASE_URL            For Step 3 — Sync Jira card status.
#   JIRA_EMAIL               (falls back to BITBUCKET_EMAIL)
#   JIRA_API_TOKEN           (falls back to BITBUCKET_API_TOKEN)
#   BITBUCKET_PR_ID          Auto-set by Bitbucket Pipelines on PR steps.
#   BITBUCKET_BRANCH         Auto-set by Bitbucket Pipelines.
#   AI_REVIEW_MAX_USD        Default 2.00 — caps spend per run. A ceiling, not a
#                            target: you pay actual usage; the cap kills runaways.
#                            Don't set below ~1.00 — a run that dies mid-review
#                            bills the tokens spent but posts nothing.
#   AI_REVIEW_MODEL          Override the model (e.g. "sonnet" for cheaper runs).
#   AI_REVIEW_OUTPUT         Path for the JSON output. Default: ./ai-review-output.json
#   AI_REVIEW_BASE_BRANCH    Base branch the diff is scoped against. Default: develop.
#                            Set to "master" (etc.) for a repo with a different
#                            integration branch. Inherited by the skill via env.
#
# Exit codes:
#   0  Run completed (review posted; findings may or may not exist).
#   1  Infrastructure failure (missing env, claude CLI not installed, etc.).
#   2  Claude returned a non-zero exit (run errored mid-flight).

set -uo pipefail

# ── Pre-flight env checks ─────────────────────────────────────────────────────
if [[ -z "${ANTHROPIC_API_KEY:-}" && -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
    echo "ERROR: set ANTHROPIC_API_KEY (API billing) or CLAUDE_CODE_OAUTH_TOKEN" >&2
    echo "       (from \`claude setup-token\`, Pro/Max subscription) for headless CI mode." >&2
    exit 1
fi
if [[ -z "${BITBUCKET_EMAIL:-}" || -z "${BITBUCKET_API_TOKEN:-}" ]]; then
    echo "ERROR: BITBUCKET_EMAIL and BITBUCKET_API_TOKEN are required (the skill posts comments via Bitbucket REST)." >&2
    exit 1
fi
if ! command -v claude >/dev/null 2>&1; then
    echo "ERROR: 'claude' CLI not on PATH. Install Claude Code in the CI image." >&2
    exit 1
fi

# ── Build the prompt ──────────────────────────────────────────────────────────
PR_ARG=""
if [[ -n "${BITBUCKET_PR_ID:-}" ]]; then
    PR_ARG="--pr=$BITBUCKET_PR_ID"
elif [[ -n "${BITBUCKET_BRANCH:-}" ]]; then
    PR_ARG="--branch=$BITBUCKET_BRANCH"
fi

PROMPT="/code-reviewer $PR_ARG"
MAX_USD="${AI_REVIEW_MAX_USD:-2.00}"
OUTPUT_FILE="${AI_REVIEW_OUTPUT:-./ai-review-output.json}"

MODEL_ARGS=()
if [[ -n "${AI_REVIEW_MODEL:-}" ]]; then
    MODEL_ARGS=(--model "$AI_REVIEW_MODEL")
fi

# Tells the skill (via SKILL.md "CI / headless mode" section) to skip prompts.
export AI_REVIEW_CI=1

# ── Tool allowlist ────────────────────────────────────────────────────────────
# Mode: --permission-mode dontAsk + UNQUALIFIED tool names below. dontAsk
# auto-denies anything not allow-listed, so the list must actually match every
# call the skill makes. Pattern-scoped entries like "Bash(git *)" DO NOT work
# here: in target mode (--pr/--branch — exactly what CI uses) the skill runs
# compound commands (`cd "$WORKTREE" && "$SKILLS_ROOT/scripts/foo.sh"`), which
# never match a single command pattern and were silently denied — the run
# analysed the diff but couldn't post. Unqualified "Bash" allows all Bash calls.
#
# Why not bypassPermissions? CI containers run as root, and the CLI hard-blocks
# bypass mode under root/sudo (exit 1, "cannot be used with root/sudo
# privileges"). There is no sanctioned override; dontAsk + a full allowlist is
# the root-compatible equivalent for this ephemeral, single-purpose container.
# Anthropic auth uses ANTHROPIC_API_KEY (a CI container has no keychain / OAuth).
ALLOWED_TOOLS=(
    "Read"
    "Write"
    "Edit"
    "Glob"
    "Grep"
    "Bash"
    "Task"
    "TodoWrite"
)

# ── Banner ────────────────────────────────────────────────────────────────────
echo "🚀 ai-review-ci — running /code-reviewer headlessly"
echo "  Prompt        : $PROMPT"
echo "  Max budget    : \$$MAX_USD"
echo "  Base branch   : ${AI_REVIEW_BASE_BRANCH:-develop}"
echo "  Auth          : $([[ -n "${ANTHROPIC_API_KEY:-}" ]] && echo "API key" || echo "OAuth token (subscription)")"
[[ -n "${AI_REVIEW_MODEL:-}" ]] && echo "  Model         : ${AI_REVIEW_MODEL}"
echo "  Output JSON   : $OUTPUT_FILE"
echo

# ── Trust the workspace so the project skill loads ────────────────────────────
# `claude --print` skips the trust *dialog* but does not *grant* trust. An
# untrusted workspace silently refuses to load the project's /code-reviewer
# skill — the prompt resolves to "Unknown command: /code-reviewer" and nothing
# runs — and ignores settings permissions. Pre-accept trust for this checkout.
CLAUDE_CONFIG="${HOME:-/root}/.claude.json"
python3 - "$PWD" "$CLAUDE_CONFIG" <<'PYTRUST' || echo "  ↷ couldn't pre-trust workspace (continuing)" >&2
import json, os, sys
workspace, cfg = sys.argv[1], sys.argv[2]
data = {}
if os.path.exists(cfg):
    try:
        data = json.load(open(cfg))
    except Exception:
        data = {}
proj = data.setdefault("projects", {}).setdefault(workspace, {})
proj["hasTrustDialogAccepted"] = True
proj["hasCompletedProjectOnboarding"] = True
with open(cfg, "w") as f:
    json.dump(data, f)
PYTRUST

# ── Invoke Claude headlessly ──────────────────────────────────────────────────
# NOTE: no --bare. --bare does NOT load project skills, so /code-reviewer would
# resolve to "Unknown command" and the review would never run. Verified against
# CLI v2.1.220. Auth still uses ANTHROPIC_API_KEY.
claude --print "$PROMPT" \
    --no-session-persistence \
    --output-format json \
    --permission-mode dontAsk \
    --max-budget-usd "$MAX_USD" \
    "${MODEL_ARGS[@]}" \
    --allowedTools "${ALLOWED_TOOLS[@]}" \
    > "$OUTPUT_FILE"
RC=$?

echo
echo "─── Claude run finished (exit code $RC) ───"
if command -v jq >/dev/null 2>&1; then
    jq -r '.result // .' "$OUTPUT_FILE" 2>/dev/null || cat "$OUTPUT_FILE"
else
    cat "$OUTPUT_FILE"
fi

if [[ $RC -ne 0 ]]; then
    echo "❌ Headless run failed (exit $RC). See $OUTPUT_FILE for details." >&2
    exit 2
fi

echo
echo "✓ ai-review-ci completed. Findings posted to PR (if any). Output: $OUTPUT_FILE"
exit 0
