#!/usr/bin/env python3
"""
ai-review — code review helper for the code-reviewer Claude Code skill.

Installed at: .claude/skills/code-reviewer/bin/ai-review

Usage:
    ai-review fix     --comment-id=<ID>                  Apply a suggested fix
    ai-review dismiss --comment-id=<ID> --reason=<TEXT>  Mark finding as won't-fix
    ai-review --help                                     Show this help

`fix` fetches a Bitbucket comment, extracts the diff from the "Suggested fix"
section, applies it to the local file, and logs to .ai-review/applied-*.log.

`dismiss` updates the comment with a ❌ banner and a dismissal marker. The next
`/code-reviewer` run reads these and skips matching findings, so the same
non-issue won't be flagged again.

Required env vars (set in .claude/settings.local.json):
    BITBUCKET_EMAIL       Your Bitbucket account email
    BITBUCKET_API_TOKEN   API token with Pull requests: write scope
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.parse
from pathlib import Path


# ── Helpers ───────────────────────────────────────────────────────────────────

def die(msg: str) -> None:
    print(f'ERROR: {msg}', file=sys.stderr)
    sys.exit(1)


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, **kwargs)


def get_creds() -> tuple[str, str]:
    email = os.environ.get('BITBUCKET_EMAIL', '')
    token = os.environ.get('BITBUCKET_API_TOKEN', '')
    if not email or not token:
        die('BITBUCKET_EMAIL and BITBUCKET_API_TOKEN must be set.\n'
            '  Add them to .claude/settings.local.json under "env".')
    return email, token


def get_repo_info() -> tuple[str, str]:
    r = run(['git', 'remote', 'get-url', 'origin'])
    if r.returncode != 0:
        die('no git remote "origin" found.')
    m = re.search(r'bitbucket\.org[:/]([^/]+)/([^/]+?)(\.git)?$', r.stdout.strip())
    if not m:
        die(f'remote URL is not a Bitbucket URL: {r.stdout.strip()}')
    return m.group(1), m.group(2)


def get_branch() -> str:
    r = run(['git', 'branch', '--show-current'])
    return r.stdout.strip()


def curl_get(url: str, auth: tuple[str, str]) -> dict:
    r = run(['curl', '-sS', '-w', '\n__HTTP__%{http_code}', '-u', f'{auth[0]}:{auth[1]}', url])
    body, _, code = r.stdout.rpartition('__HTTP__')
    code = code.strip()
    if code in ('401', '403'):
        die(f'Bitbucket rejected the API credentials (HTTP {code}). Your BITBUCKET_API_TOKEN is\n'
            '  invalid, expired, or lacks Bitbucket scopes. Regenerate it at\n'
            '  https://id.atlassian.com/manage-profile/security/api-tokens (Pull requests: read+write)\n'
            '  and confirm BITBUCKET_EMAIL matches that Atlassian account.')
    if r.returncode != 0 or code not in ('200', '201'):
        die(f'Bitbucket API request failed (HTTP {code or "?"}):\n  {r.stderr.strip() or body.strip()}')
    return json.loads(body)


def find_pr_id(api_base: str, auth: tuple[str, str], branch: str) -> str:
    q = urllib.parse.quote(f'source.branch.name="{branch}" AND state="OPEN"')
    data = curl_get(f'{api_base}/pullrequests?q={q}&fields=values.id,values.title', auth)
    prs = data.get('values', [])
    if not prs:
        die(f'no open PR found for branch "{branch}".\n  Push the branch and open a PR first.')
    pr = prs[0]
    print(f'Found PR #{pr["id"]}')
    return str(pr['id'])


# ── Diff extraction and application ──────────────────────────────────────────

def extract_diff(body: str) -> str | None:
    """Pull the first ```diff...``` block out of a comment body."""
    m = re.search(r'```diff\s*\n(.*?)\n```', body, re.DOTALL)
    return m.group(1).strip() if m else None


def extract_prompt(body: str) -> str:
    """Pull the ```prompt...``` block out of a comment body."""
    m = re.search(r'```prompt\s*\n(.*?)\n```', body, re.DOTALL)
    return m.group(1).strip() if m else ''


def apply_diff(file_path: str, raw_diff: str) -> bool:
    """
    Wrap the raw diff lines in a minimal unified-diff header and apply via
    git apply. Returns True on success.
    """
    patch = f'--- a/{file_path}\n+++ b/{file_path}\n{raw_diff}\n'
    r = run(['git', 'apply', '--index', '-'], input=patch)
    if r.returncode == 0:
        return True
    # Retry without --index (file may be untracked or not staged)
    r = run(['git', 'apply', '-'], input=patch)
    return r.returncode == 0


def write_log(file_path: str, line: int | None, prompt: str, diff: str) -> Path:
    log_dir = Path('.ai-review')
    log_dir.mkdir(exist_ok=True)
    ts = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
    log_file = log_dir / f'applied-{ts}.log'
    log_file.write_text(
        f'File: {file_path}:{line or "?"}\n\n'
        f'Prompt:\n{prompt}\n\n'
        f'Diff applied:\n{diff}\n'
    )
    return log_file


# ── Shared parsers / signatures ──────────────────────────────────────────────

def extract_meta(body: str) -> dict:
    """Extract the dim/severity meta marker, if present."""
    m = re.search(r'<!--\s*ai-review:meta\s+(\{[^}]+\})\s*-->', body)
    if not m:
        return {}
    try:
        return json.loads(m.group(1))
    except json.JSONDecodeError:
        return {}


def line_signature(file_path: str, line: int | None) -> str:
    """SHA1 (12 hex chars) of 3 trimmed lines centred on `line` (1-indexed).
    Stored on a dismissal so future runs can detect when a dismissed block
    has moved or changed substantially."""
    if not line or line < 1:
        return ''
    try:
        with open(file_path) as f:
            lines = f.readlines()
    except (OSError, UnicodeDecodeError):
        return ''
    if not lines:
        return ''
    idx   = line - 1
    start = max(0, idx - 1)
    end   = min(len(lines), idx + 2)
    block = '\n'.join(ln.strip() for ln in lines[start:end])
    return hashlib.sha1(block.encode('utf-8')).hexdigest()[:12]


# ── fix subcommand ────────────────────────────────────────────────────────────

def cmd_fix(args: argparse.Namespace) -> None:
    branch = get_branch()
    if branch in ('main', 'master', 'develop'):
        die(f'Refusing to apply fixes on protected branch "{branch}".')

    auth = get_creds()
    workspace, repo_slug = get_repo_info()
    api_base = f'https://api.bitbucket.org/2.0/repositories/{workspace}/{repo_slug}'

    pr_id   = find_pr_id(api_base, auth, branch)
    comment = curl_get(f'{api_base}/pullrequests/{pr_id}/comments/{args.comment_id}', auth)

    body     = comment.get('content', {}).get('raw', '')
    inline   = comment.get('inline', {})
    filepath = inline.get('path', '')
    line_num = inline.get('to')

    diff = extract_diff(body)
    if not diff:
        print('No diff block found in the comment.', file=sys.stderr)
        print('Apply the fix manually using the prompt in section 2 of the comment.')
        sys.exit(1)

    if not filepath:
        die('Comment has no inline file path — cannot determine which file to patch.\n'
            'Apply the fix manually using the prompt in section 2 of the comment.')

    print(f'Applying fix to {filepath}:{line_num or "?"}...')

    if apply_diff(filepath, diff):
        print(f'✓ Fixed {filepath}:{line_num or "?"}')
        log = write_log(filepath, line_num, extract_prompt(body), diff)
        print(f'  Logged to {log}')
    else:
        print('✗ git apply failed — the diff may not apply cleanly.', file=sys.stderr)
        print('  Apply the fix manually using the prompt in section 2 of the comment.')
        sys.exit(1)


# ── dismiss subcommand ──────────────────────────────────────────────────────

def cmd_dismiss(args: argparse.Namespace) -> None:
    reason = args.reason.strip()
    if not reason:
        die('--reason cannot be empty. Give a short explanation of why this is not a real issue.')

    auth = get_creds()
    workspace, repo_slug = get_repo_info()
    branch = get_branch()
    api_base = f'https://api.bitbucket.org/2.0/repositories/{workspace}/{repo_slug}'

    pr_id   = find_pr_id(api_base, auth, branch)
    comment_url = f'{api_base}/pullrequests/{pr_id}/comments/{args.comment_id}'
    comment = curl_get(comment_url, auth)

    body     = comment.get('content', {}).get('raw', '')
    inline   = comment.get('inline', {})
    filepath = inline.get('path', '')
    line_num = inline.get('to')

    if not filepath:
        die('Comment has no inline code location — cannot dismiss without a path.')

    meta = extract_meta(body)
    sig  = line_signature(filepath, line_num)

    dismiss_meta = {k: v for k, v in {
        'path':     filepath,
        'line':     line_num,
        'sig':      sig,
        'dim':      meta.get('dim'),
        'severity': meta.get('severity'),
        'reason':   reason,
    }.items() if v not in (None, '')}

    # Strip the open marker — the dismissed marker takes its place.
    cleaned = re.sub(r'\s*<!--\s*ai-review:open:[a-f0-9]+\s*-->', '', body).rstrip()
    cleaned = re.sub(r'\s*<!--\s*ai-review:meta\s+\{[^}]+\}\s*-->', '', cleaned).rstrip()

    meta_json = json.dumps(dismiss_meta, separators=(',', ':'))
    updated_body = (
        f'❌ **Dismissed** — {reason}\n\n'
        f'<!-- ai-review:dismissed {meta_json} -->\n\n'
        f'---\n\n'
        f'*(Original review)*\n\n'
        f'{cleaned}'
    )

    r = run(['curl', '-sSf', '-u', f'{auth[0]}:{auth[1]}',
             '-X', 'PUT',
             '-H', 'Content-Type: application/json',
             '-d', json.dumps({'content': {'raw': updated_body}}),
             comment_url])
    if r.returncode != 0:
        die(f'PUT failed: {r.stderr.strip() or r.stdout.strip()}')
    print(f'  ❌ comment #{args.comment_id} dismissed ({filepath}:{line_num or "?"})')
    print(f'  Reason: {reason}')


# ── CLI ───────────────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        prog='ai-review',
        description=(
            'Code review helper.\n\n'
            'Subcommands:\n'
            '  fix      Apply a suggested fix from a posted Bitbucket PR comment.\n'
            '  dismiss  Mark a finding as wont-fix so future runs skip it.'
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest='command')

    fix_p = sub.add_parser('fix', help='Apply a fix from a posted comment')
    fix_p.add_argument(
        '--comment-id', required=True, type=int,
        help='Bitbucket comment ID printed in the auto-fix command at the bottom of the PR comment',
    )

    dismiss_p = sub.add_parser('dismiss', help='Dismiss a finding as wont-fix')
    dismiss_p.add_argument(
        '--comment-id', required=True, type=int,
        help='Bitbucket comment ID of the finding to dismiss',
    )
    dismiss_p.add_argument(
        '--reason', required=True,
        help='Short explanation of why this is not a real issue (recorded on the comment)',
    )

    args = parser.parse_args()

    if args.command == 'fix':
        cmd_fix(args)
    elif args.command == 'dismiss':
        cmd_dismiss(args)
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
